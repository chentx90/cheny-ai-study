# 后端配置模板
# 使用方法：复制为 backend/.env，然后按本机环境修改。
# 注意：backend/.env 会被 .gitignore 忽略，真实密钥不要提交到 Git。

# PostgreSQL 连接串。
# 当前 docker-compose 默认数据库端口是 5433。
POSTGRES_DSN=postgresql://rag_user:rag_pass@localhost:5433/rag_db

# 允许访问后端 API 的前端地址。
# 本地 Next.js 端口可能从 3000 切到 3001/3002，所以开发环境可以都放行。
# 生产部署时改成正式前端域名，例如：https://rag.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# MinIO 对象存储配置。
# 用于保存上传的原始文件，便于召回时追溯原文。
# 如果 MinIO 不可用，系统会降级到 LOCAL_OBJECT_STORAGE 本地目录。
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-raw-files
MINIO_SECURE=false

# 本地对象存储目录。
# 相对路径会按 backend/ 目录解析；object_storage 表示 backend/object_storage。
LOCAL_OBJECT_STORAGE=object_storage

# LLM 配置。
# 用于可选的标题提取、chunk 摘要、预设问题生成。
# 不填 LLM_API_KEY 时不阻断解析，只是不做 LLM 富化。
# OpenAI 官方示例：LLM_BASE_URL=https://api.openai.com/v1
# NewAPI / OneAPI 示例：LLM_BASE_URL=http://localhost:3000/v1
LLM_API_KEY=
LLM_BASE_URL=http://localhost:3000/v1
LLM_MODEL=gpt-4o-mini

# Embedding 配置。
# 用于知识入库向量和检索查询向量。
# 只调用第三方 OpenAI-compatible /embeddings API，不再使用本地 mock 或本地模型。
# 如果 EMBEDDING_API_KEY 为空，会复用 LLM_API_KEY。
# 注意 EMBEDDING_DIMENSION 必须与数据库 vector 维度一致；bge-m3 通常为 1024 维。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=http://localhost:3000/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Reranker 配置。
# 用于向量召回后的证据重排，调用 NewAPI/第三方兼容的 POST {RERANKER_BASE_URL}/rerank。
# 如果 RERANKER_API_KEY 为空，会复用 LLM_API_KEY；如果任一项为空，rerank 算子会跳过。
# 示例模型：Pro/BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_BASE_URL=http://localhost:3000/v1
RERANKER_MODEL=

# OCR 配置。
# 用于扫描 PDF 页面识别。后端会把 PDF 页面转成图片，再调用视觉模型 chat/completions。
# 仅调用第三方 NewAPI/OpenAI-compatible API，不再维护本地 OCR 模型服务。
# 如果 OCR_API_KEY 为空，会复用 LLM_API_KEY；如果任一项为空，OCR 会跳过。
# 示例模型：gpt-4o-mini 或供应商提供的视觉 OCR 模型。
OCR_API_KEY=
OCR_BASE_URL=http://localhost:3000/v1
OCR_MODEL=

# 调试开关。
DEBUG=true
